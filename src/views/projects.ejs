<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% projects.forEach (project => { %>
            <li><strong><a href="/project/<%= project.project_id %>"><%= project.title %></a> <i>(<a href="/organization/<%= project.organization_id %>"><%= project.name %></a>)</i></strong></li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>