<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% projects.forEach (project => { %>
            <li><%= project.display_date %>: <i><%= project.title %></i> <strong>(<%= project.name %>)</strong></li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>